@using Planmenus.Data.Entities
@model Planmenus.Models.VMTicket
@{
    Layout = null;
    var f = Model.formato ?? new MDTicketera();
    var directa = f.tk_modo != ModoImpresion.Navegador && Model.ticket > 0;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ticket @Model.ticket.ToString("D6")</title>
    <style>
        /* El ancho del papel se toma de la configuracion de la ticketera (58 u 80 mm) */
        @@page { size: @(Model.ancho_mm)mm auto; margin: 0; }
        * { box-sizing: border-box; }
        body { margin: 0; background: #e9e4dc; }
        .hoja { width: @(Model.ancho_mm)mm; margin: 16px auto; box-shadow: 0 6px 20px rgba(0,0,0,.12); }
        .acciones { width: @(Model.ancho_mm)mm; min-width: 260px; margin: 0 auto 16px; display: flex; flex-wrap: wrap; gap: 6px; font-family: system-ui, sans-serif; }
        .acciones a, .acciones button { flex: 1 1 45%; padding: 9px; border: 0; border-radius: 8px; background: #e4572e; color: #fff; text-decoration: none; text-align: center; font-size: 13px; font-weight: 600; cursor: pointer; }
        .acciones .sec { background: #3a312b; }
        .acciones form { display: contents; }
        .msg { width: @(Model.ancho_mm)mm; min-width: 260px; margin: 12px auto 0; padding: 8px 10px; font: 13px system-ui, sans-serif; border-radius: 8px; }
        .ok { background: #e3f3ea; color: #1d5c3a; } .err { background: #fde4e1; color: #7a1610; }
        @@media print {
            body { background: #fff; }
            .hoja { margin: 0; width: 100%; box-shadow: none; }
            .tkp { width: 100% !important; }
            .acciones, .msg { display: none; }
        }
    </style>
</head>
<body>
    @if (TempData["success"] != null) { <div class="msg ok">✓ @TempData["success"]</div> }
    @if (TempData["error"] != null) { <div class="msg err">@TempData["error"]</div> }

    <div class="hoja"><partial name="_TicketPapel" model="Model" /></div>

    <div class="acciones">
        @if (directa)
        {
            <form asp-controller="MDCajas" asp-action="Imprimir" asp-route-id="@Model.ticket" method="post">
                <button type="submit">🖨 Imprimir en ticketera</button>
            </form>
            <button type="button" class="sec" onclick="window.print()">Imprimir desde el navegador</button>
        }
        else
        {
            <button type="button" onclick="window.print()">🖨 Imprimir</button>
        }
        @if (Model.ticket > 0) { <a asp-controller="Crearpdf" asp-action="Index" asp-route-id_caja="@Model.ticket" target="_blank" class="sec">Ver PDF</a> }
        <button type="button" class="sec" onclick="window.close()">Cerrar</button>
    </div>

    @if (ViewBag.imprimir == true)
    {
        <script>
            // Con Chrome/Edge iniciado con --kiosk-printing se imprime sin mostrar el dialogo
            window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 300); });
        </script>
    }
</body>
</html>
