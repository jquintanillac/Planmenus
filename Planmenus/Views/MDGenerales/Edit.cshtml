@model Planmenus.Data.Entities.MDGenerales

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="card">
        <div class="card-header">
             <div class="div-title">
				<h2 class="text-center">EDITAR DATOS EMPRESA</h2>
			 </div>
        </div>
        <div class="card-body">
             <div class="row">
                <div class="col-5">
                     <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="id_gene" />
                        <div class="form-group">
                            <label asp-for="gene_empre" class="control-label"></label>
                            <input asp-for="gene_empre" class="form-control" />
                            <span asp-validation-for="gene_empre" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="gene_ruc" class="control-label"></label>
                            <input asp-for="gene_ruc" class="form-control" />
                            <span asp-validation-for="gene_ruc" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="gene_direc" class="control-label"></label>
                            <input asp-for="gene_direc" class="form-control" />
                            <span asp-validation-for="gene_direc" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="gene_telef" class="control-label"></label>
                            <input asp-for="gene_telef" class="form-control" />
                            <span asp-validation-for="gene_telef" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="gene_url" class="control-label"></label>
                            <input asp-for="gene_url" class="form-control" />
                            <span asp-validation-for="gene_url" class="text-danger"></span>
                        </div>
                        <h5 class="mt-4">Ticketera</h5>
                        <div class="form-row">
                            <div class="form-group col-6">
                                <label asp-for="gene_ticket_ancho" class="control-label"></label>
                                <select asp-for="gene_ticket_ancho" class="form-control">
                                    <option value="80">80 mm</option>
                                    <option value="58">58 mm</option>
                                </select>
                            </div>
                            <div class="form-group col-6">
                                <label asp-for="gene_ticket_pie" class="control-label"></label>
                                <input asp-for="gene_ticket_pie" class="form-control" placeholder="¡Gracias por su preferencia!" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-8">
                                <label asp-for="gene_impresora_ip" class="control-label"></label>
                                <input asp-for="gene_impresora_ip" class="form-control" placeholder="Ej.: 192.168.1.100 (opcional)" />
                                <small class="form-text text-muted">Solo si la aplicación corre en el mismo local que la ticketera de red. Si no, se imprime desde el navegador.</small>
                            </div>
                            <div class="form-group col-4">
                                <label asp-for="gene_impresora_puerto" class="control-label"></label>
                                <input asp-for="gene_impresora_puerto" class="form-control" />
                            </div>
                        </div>
                        <div class="form-group">
                            <input type="submit" value="Grabar" class="btn btn-sm btn-primary" />
                             <a class="btn btn-sm btn-primary" asp-action="Index">Regresar</a>
                        </div>
                    </form>
                </div>
                <div class="col-md-7">
                    <img src="~/AdminX-master/demo/img/menueditar.jpg" width="580" height="400" />
                </div>
            </div> 
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
