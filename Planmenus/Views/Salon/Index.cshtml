@using Planmenus.Data.Entities
@model Planmenus.Models.VMSalon
@{
    ViewData["Title"] = "Salón y mesas";
    var plano = (Planmenus.Services.PlanoService.Plano)ViewBag.plano;
    string usuario = ViewBag.usuario;
    var peru = System.Globalization.CultureInfo.GetCultureInfo("es-PE");
    string Soles(decimal m) => "S/ " + m.ToString("N0", peru);
    string Espera(DateTime d) { var min = (int)(Model.ahora - d).TotalMinutes; return min < 60 ? $"{min} min" : $"{min / 60} h {min % 60} m"; }
    string Cocina(byte e) => e switch { EstadoCocina.EnCocina => "En cocina", EstadoCocina.Listo => "Listo para servir", _ => "Servido" };
    string Iniciales(string n) => string.Concat((n ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
    var mesasZona = plano.MesasDeZona.ToList();
    bool tengoMesas = plano.mesas.Any(m => m.mozo_usuario == usuario);
}
<link rel="stylesheet" href="~/css/plano.css" asp-append-version="true" />

<div class="d-flex flex-wrap align-items-center mb-3" style="gap:10px">
    <div class="pm-leyenda">
        <span class="pill"><i style="background:var(--hierba)"></i>@plano.mesas.Count(m => m.estado == "libre") libres</span>
        <span class="pill"><i style="background:var(--aji)"></i>@plano.mesas.Count(m => m.estado == "ocupada") ocupadas</span>
        <span class="pill"><i style="background:var(--mostaza)"></i>@plano.mesas.Count(m => m.estado == "listo") listas para servir</span>
        <span class="pill"><i style="background:#7b6ad8"></i>@plano.mesas.Count(m => m.estado == "reservada") reservadas</span>
    </div>
    <span class="flex-fill"></span>
    @if (tengoMesas)
    {
        <div class="custom-control custom-switch">
            <input type="checkbox" class="custom-control-input" id="soloMias" />
            <label class="custom-control-label" for="soloMias">Solo mis mesas</label>
        </div>
    }
    @if (User.HasClaim("submenu2_10", "S")) { <a class="btn btn-sm btn-light" asp-controller="Plano" asp-action="Index" asp-route-zona="@plano.zona_actual"><i data-feather="edit-3" style="width:15px;height:15px"></i> Editar plano</a> }
    <a class="btn btn-sm btn-light" asp-controller="MDCajas" asp-action="Create"><i data-feather="shopping-bag" style="width:15px;height:15px"></i> Para llevar</a>
</div>

@if (plano.zonas.Count > 1)
{
    <div class="pm-zonas">
        @foreach (var z in plano.zonas)
        {
            var ocupadas = plano.mesas.Count(m => m.zona == z.id_zona && (m.estado == "ocupada" || m.estado == "listo"));
            <a asp-action="Index" asp-route-zona="@z.id_zona" class="@(z.id_zona == plano.zona_actual ? "activa" : "")">@z.zona_desc @if (ocupadas > 0) { <span class="badge badge-coc ml-1">@ocupadas</span> }</a>
        }
    </div>
}

@if (plano.mesas.Count == 0)
{
    <div class="card"><div class="card-body vacio">
        <i data-feather="grid"></i>
        <p class="mb-2">Aún no hay mesas en el salón.</p>
        @if (User.HasClaim("submenu2_10", "S")) { <a class="btn btn-primary btn-sm" asp-controller="Plano" asp-action="Index">Armar el plano</a> }
    </div></div>
}
else
{
    <div class="pm-scroll">
        <div class="pm-lienzo" id="lienzo" data-vacio="Esta zona no tiene mesas">
            @foreach (var m in mesasZona)
            {
                var titulo = m.estado switch
                {
                    "libre" => $"{m.desc}: libre, {m.cap} personas. Tomar pedido",
                    "reservada" => $"{m.desc}: reservada {m.reserva_hora:HH:mm} para {m.reserva_cliente} ({m.reserva_personas} pers.)",
                    _ => $"{m.desc}: {Soles(m.monto)} · {m.platos} plato(s) · {Espera(m.desde.Value)}"
                };
                var href = m.id_caja != null
                    ? Url.Action("Pedido", new { id = m.id_caja })
                    : Url.Action("Create", "MDCajas", new { id_mesa = m.id });
                <div class="pm-mesa forma-@m.forma estado-@m.estado @(m.mozo_usuario == usuario && usuario != null ? "mia" : "")"
                     data-x="@m.x" data-y="@m.y" data-w="@m.w" data-h="@m.h" data-rot="@m.rot" data-cap="@m.cap" data-forma="@m.forma">
                    <a class="pm-tablero" href="@href" title="@titulo" aria-label="@titulo">
                        <div class="pm-info">
                            <span class="pm-num">@m.nro</span>
                            @switch (m.estado)
                            {
                                case "libre": <span class="pm-sub">@m.cap pers.</span> break;
                                case "reservada": <span class="pm-sub">Res. @m.reserva_hora?.ToString("HH:mm")</span> break;
                                default: <span class="pm-sub">@Soles(m.monto) · @Espera(m.desde.Value)</span> break;
                            }
                        </div>
                    </a>
                    @if (!string.IsNullOrEmpty(m.mozo)) { <span class="pm-mozo" title="Mozo: @m.mozo">@Iniciales(m.mozo)</span> }
                </div>
            }
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead><tr><th>Mesa</th><th>Estado</th><th>Mozo</th><th>Detalle</th><th class="text-right">Total</th></tr></thead>
                <tbody>
                    @foreach (var m in mesasZona.Where(x => x.estado != "libre").OrderBy(x => x.desde ?? x.reserva_hora))
                    {
                        <tr>
                            <td><strong>@m.nro</strong> · @m.desc</td>
                            <td>
                                @if (m.estado == "reservada") { <span class="badge" style="background:#efecfb;color:#5b4bc4">Reservada @m.reserva_hora?.ToString("HH:mm")</span> }
                                else { <span class="badge @(m.estado == "listo" ? "badge-pend" : "badge-coc")">@(m.estado == "listo" ? "Listo para servir" : "Ocupada")</span> }
                            </td>
                            <td>@m.mozo</td>
                            <td>@(m.estado == "reservada" ? $"{m.reserva_cliente} · {m.reserva_personas} pers." : $"{m.platos} plato(s) · {Espera(m.desde.Value)}")</td>
                            <td class="text-right">
                                @if (m.id_caja != null) { <a asp-action="Pedido" asp-route-id="@m.id_caja" class="font-weight-bold">@Soles(m.monto)</a> }
                            </td>
                        </tr>
                    }
                    @if (!mesasZona.Any(x => x.estado != "libre")) { <tr><td colspan="5" class="text-muted px-3">Todas las mesas de esta zona están libres.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.sin_mesa.Count > 0)
{
    <div class="card mt-3">
        <div class="card-header"><strong>Para llevar y delivery por cobrar</strong></div>
        <div class="card-body p-0">
            <table class="table mb-0">
                <thead><tr><th>Pedido</th><th>Platos</th><th>Espera</th><th>Cocina</th><th class="text-right">Total</th><th></th></tr></thead>
                <tbody>
                    @foreach (var p in Model.sin_mesa)
                    {
                        <tr>
                            <td>N° @p.id_caja.ToString("D6") @if (!string.IsNullOrWhiteSpace(p.obs)) { <div class="small text-muted">@p.obs</div> }</td>
                            <td>@p.platos</td>
                            <td>@Espera(p.desde)</td>
                            <td><span class="badge @(p.cocina == EstadoCocina.Listo ? "badge-pend" : "badge-coc")">@Cocina(p.cocina)</span></td>
                            <td class="text-right font-weight-bold">S/ @p.monto.ToString("N2", peru)</td>
                            <td class="text-right"><a class="btn btn-sm btn-primary" asp-action="Pedido" asp-route-id="@p.id_caja">Ver / cobrar</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
<script src="~/js/plano.js" asp-append-version="true"></script>
<script>
(function () {
    var lienzo = document.getElementById('lienzo');
    if (lienzo) Plano.iniciar(lienzo);
    var sw = document.getElementById('soloMias');
    if (sw && lienzo) {
        try { sw.checked = localStorage.getItem('salon-solo-mias') === '1'; } catch (e) { }
        lienzo.classList.toggle('solo-mias', sw.checked);
        sw.addEventListener('change', function () {
            lienzo.classList.toggle('solo-mias', sw.checked);
            try { localStorage.setItem('salon-solo-mias', sw.checked ? '1' : '0'); } catch (e) { }
        });
    }
    // El salon se refresca solo cada 30 segundos para ver mesas nuevas o pedidos listos
    setTimeout(function () { location.reload(); }, 30000);
})();
</script>
}
