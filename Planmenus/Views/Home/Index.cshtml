@inject Planmenus.Services.TicketService Tickets
@{
    Layout = null;
    var empresa = await Tickets.ObtenerEmpresaAsync();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ingresar · @empresa.gene_empre</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tema.css" asp-append-version="true" />
    <style>
        .login { display: grid; grid-template-columns: 1.15fr 1fr; min-height: 100vh; }
        .login-foto {
            position: relative; color: #fff; padding: 48px;
            display: flex; flex-direction: column; justify-content: flex-end;
            background: linear-gradient(180deg, rgba(31,26,23,.15) 0%, rgba(31,26,23,.85) 100%), url('@Url.Content("~/AdminX-master/demo/img/fondo.jpg")') center/cover;
        }
        .login-foto .marca { position: absolute; top: 40px; left: 48px; display: flex; align-items: center; gap: 12px; }
        .login-foto h1 { color: #fff; font-size: clamp(32px, 4vw, 52px); line-height: 1.05; margin: 0 0 14px; max-width: 14ch; }
        .login-foto p { font-size: 17px; max-width: 42ch; opacity: .9; margin: 0; }
        .login-foto .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
        .login-foto .chips span { background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.25); backdrop-filter: blur(6px); padding: 6px 12px; border-radius: 999px; font-size: 13px; }
        .login-form { display: flex; align-items: center; justify-content: center; padding: 32px 16px; }
        .login-caja { width: 100%; max-width: 380px; }
        .login-caja h2 { font-size: 30px; margin: 0 0 6px; }
        .login-caja .form-control { height: 48px; font-size: 15px; }
        .login-caja .btn { height: 48px; font-size: 15px; }
        .clave { position: relative; }
        .clave button { position: absolute; right: 6px; top: 50%; transform: translateY(-50%); border: 0; background: transparent; color: var(--gris); padding: 6px 8px; border-radius: 8px; font-size: 13px; font-weight: 600; }
        .clave button:hover { background: var(--crema); color: var(--tinta); }
        @@media (max-width: 860px) {
            .login { grid-template-columns: 1fr; }
            .login-foto { min-height: 240px; padding: 28px 20px; }
            .login-foto .marca { top: 22px; left: 20px; }
            .login-foto .chips { display: none; }
        }
    </style>
</head>
<body>
    <div class="login">
        <section class="login-foto">
            <div class="marca">
                <span class="app-marca-icono" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18h18"/><path d="M4 18a8 8 0 0 1 16 0"/><path d="M12 7V5"/><path d="M10 5h4"/></svg>
                </span>
                <strong class="titulo-serif" style="color:#fff;font-size:20px">@empresa.gene_empre</strong>
            </div>
            <h1>El menú del día, sin enredos.</h1>
            <p>Programa tus platos, toma pedidos por mesa, avisa a cocina y cuadra la caja desde un solo lugar.</p>
            <div class="chips"><span>Venta rápida</span><span>Salón y mesas</span><span>Cocina en vivo</span><span>Ticketera</span><span>Carta con QR</span></div>
        </section>

        <section class="login-form">
            <div class="login-caja">
                <h2>¡Hola de nuevo!</h2>
                <p class="text-muted mb-4">Ingrese con su usuario para empezar el turno.</p>

                @if (TempData["success"] != null) { <div class="alert alert-success">@TempData["success"]</div> }
                @if (TempData["error"] != null) { <div class="alert alert-danger">@TempData["error"]</div> }

                <form asp-action="Login" asp-controller="Home" method="post">
                    <div class="form-group">
                        <label for="Usua_user">Usuario</label>
                        <input type="text" class="form-control" id="Usua_user" name="Usua_user" placeholder="Ej.: caja1" autocomplete="username" autofocus required />
                    </div>
                    <div class="form-group">
                        <label for="Usua_pass">Contraseña</label>
                        <div class="clave">
                            <input type="password" class="form-control" id="Usua_pass" name="Usua_pass" placeholder="••••••••" autocomplete="current-password" required />
                            <button type="button" id="verClave" aria-label="Mostrar contraseña">Ver</button>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block mt-4">Ingresar</button>
                </form>
                <p class="text-muted small mt-4 mb-0">¿Olvidó su contraseña? Pídale al administrador que la cambie desde Usuarios.</p>
                <p class="mt-3 mb-0">¿Aún no tiene cuenta? <a asp-controller="Registro" asp-action="Index"><strong>Cree su restaurante gratis</strong></a></p>
            </div>
        </section>
    </div>
    <script>
        document.getElementById('verClave').addEventListener('click', function () {
            var i = document.getElementById('Usua_pass'), ver = i.type === 'password';
            i.type = ver ? 'text' : 'password';
            this.textContent = ver ? 'Ocultar' : 'Ver';
            this.setAttribute('aria-label', ver ? 'Ocultar contraseña' : 'Mostrar contraseña');
        });
    </script>
</body>
</html>
