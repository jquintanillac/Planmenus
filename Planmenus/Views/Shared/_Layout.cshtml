@using Planmenus.Helpers
@inject Planmenus.Services.TicketService Tickets
@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    var ayuda = Ayuda.Buscar(controlador, accion);
    var empresa = await Tickets.ObtenerEmpresaAsync();
    var nombre = SessionHelper.GetName(User);
    var iniciales = string.Concat((nombre ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
    var titulo = ayuda?.Titulo ?? (ViewData["Title"] as string ?? "");
    bool Puede(string claim) => SessionHelper.GetValue(User, claim) == "S";
    bool Activo(string c, string a) => string.Equals(c, controlador, StringComparison.OrdinalIgnoreCase)
                                       && (a == null || string.Equals(a, accion, StringComparison.OrdinalIgnoreCase));
    bool GrupoActivo(params string[] controladores) => controladores.Any(c => string.Equals(c, controlador, StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@(string.IsNullOrEmpty(titulo) ? "" : titulo + " · ")@empresa.gene_empre</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tema.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" />
</head>
<body>
<div class="app" id="app">
    <aside class="app-menu" id="menu" aria-label="Menú principal">
        <a class="app-marca" asp-controller="Home" asp-action="Inicio">
            <span class="app-marca-icono" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18h18"/><path d="M4 18a8 8 0 0 1 16 0"/><path d="M12 7V5"/><path d="M10 5h4"/></svg>
            </span>
            <span class="app-marca-texto">
                <strong>@empresa.gene_empre</strong>
                <small>Menú del día</small>
            </span>
        </a>

        <ul class="app-nav">
            <li><a asp-controller="Home" asp-action="Inicio" class="@(Activo("Home", "Inicio") ? "activo" : "")"><i data-feather="home"></i> Inicio</a></li>

            @if (Puede("menu3"))
            {
                @if (Puede("submenu3_1") || Puede("submenu3_8") || Puede("submenu3_9")) { <li class="app-nav-titulo">Atención</li> }
                @if (Puede("submenu3_1")) { <li><a asp-controller="MDCajas" asp-action="Create" class="@(Activo("MDCajas", "Create") ? "activo" : "")"><i data-feather="shopping-bag"></i> Nueva venta</a></li> }
                @if (Puede("submenu3_8")) { <li><a asp-controller="Salon" asp-action="Index" class="@(Activo("Salon", null) ? "activo" : "")"><i data-feather="grid"></i> Salón y mesas</a></li> }
                @if (Puede("submenu3_9")) { <li><a asp-controller="Cocina" asp-action="Index" class="@(Activo("Cocina", null) ? "activo" : "")"><i data-feather="bell"></i> Cocina</a></li> }

                @if (Puede("submenu3_10") || Puede("submenu3_3") || Puede("submenu3_2") || Puede("submenu3_4") || Puede("submenu3_5") || Puede("submenu3_6") || Puede("submenu3_7")) { <li class="app-nav-titulo">Caja</li> }
                @if (Puede("submenu3_10")) { <li><a asp-controller="Turnos" asp-action="Index" class="@(Activo("Turnos", null) ? "activo" : "")"><i data-feather="lock"></i> Apertura y cierre</a></li> }
                @if (Puede("submenu3_3")) { <li><a asp-controller="MDCajas" asp-action="Cajadiaria" class="@(Activo("MDCajas", "Cajadiaria") || Activo("MDCajas", "Edit") ? "activo" : "")"><i data-feather="list"></i> Lista de tickets</a></li> }
                @if (Puede("submenu3_2")) { <li><a asp-controller="MDCajas" asp-action="Index" class="@(Activo("MDCajas", "Index") ? "activo" : "")"><i data-feather="file-text"></i> Cuadre de caja</a></li> }
                @if (Puede("submenu3_4") || Puede("submenu3_5") || Puede("submenu3_6") || Puede("submenu3_7"))
                {
                    var repActivo = Activo("MDCajas", "RptListpagos") || Activo("MDCajas", "Rpttipodepago") || Activo("MDCajas", "Rptporplato") || Activo("MDCajas", "Rptcantplato");
                    <li>
                        <span class="grupo" data-toggle="collapse" data-target="#nav-reportes" aria-expanded="@(repActivo ? "true" : "false")" role="button"><i data-feather="bar-chart-2"></i> Reportes <i data-feather="chevron-right" class="flecha"></i></span>
                        <ul class="sub collapse @(repActivo ? "show" : "")" id="nav-reportes">
                            @if (Puede("submenu3_4")) { <li><a asp-controller="MDCajas" asp-action="RptListpagos" class="@(Activo("MDCajas", "RptListpagos") ? "activo" : "")">Resumen por tipo de pago</a></li> }
                            @if (Puede("submenu3_5")) { <li><a asp-controller="MDCajas" asp-action="Rpttipodepago" class="@(Activo("MDCajas", "Rpttipodepago") ? "activo" : "")">Ventas por tipo de pago</a></li> }
                            @if (Puede("submenu3_6")) { <li><a asp-controller="MDCajas" asp-action="Rptporplato" class="@(Activo("MDCajas", "Rptporplato") ? "activo" : "")">Resumen por plato</a></li> }
                            @if (Puede("submenu3_7")) { <li><a asp-controller="MDCajas" asp-action="Rptcantplato" class="@(Activo("MDCajas", "Rptcantplato") ? "activo" : "")">Ventas por plato</a></li> }
                        </ul>
                    </li>
                }
            }

            @if (Puede("menu2"))
            {
                <li class="app-nav-titulo">Carta y planificación</li>
                @if (Puede("submenu2_1")) { <li><a asp-controller="MDMenus" asp-action="Index" class="@(Activo("MDMenus", null) && accion != "Calendar" ? "activo" : "")"><i data-feather="book-open"></i> Menú del día</a></li> }
                @if (Puede("submenu2_4")) { <li><a asp-controller="MDMenus" asp-action="Calendar" class="@(Activo("MDMenus", "Calendar") ? "activo" : "")"><i data-feather="calendar"></i> Calendario</a></li> }
                @if (Puede("submenu2_9")) { <li><a asp-controller="Carta" asp-action="Qr" class="@(Activo("Carta", null) ? "activo" : "")"><i data-feather="smartphone"></i> Carta digital (QR)</a></li> }

                    var catActivo = GrupoActivo("MDMesas", "MDTipo_pago", "MDDeliveries", "MDEgresos", "MDIngresos", "MDInicials");

                <li>
                    <span class="grupo" data-toggle="collapse" data-target="#nav-catalogos" aria-expanded="@(catActivo ? "true" : "false")" role="button"><i data-feather="layers"></i> Catálogos y movimientos <i data-feather="chevron-right" class="flecha"></i></span>
                    <ul class="sub collapse @(catActivo ? "show" : "")" id="nav-catalogos">
                        @if (Puede("submenu2_5")) { <li><a asp-controller="MDMesas" asp-action="Index" class="@(Activo("MDMesas", null) ? "activo" : "")">Mesas</a></li> }
                        @if (Puede("submenu2_2")) { <li><a asp-controller="MDTipo_pago" asp-action="Index" class="@(Activo("MDTipo_pago", null) ? "activo" : "")">Tipos de pago</a></li> }
                        @if (Puede("submenu2_3")) { <li><a asp-controller="MDDeliveries" asp-action="Index" class="@(Activo("MDDeliveries", null) ? "activo" : "")">Repartidores</a></li> }
                        @if (Puede("submenu2_6")) { <li><a asp-controller="MDEgresos" asp-action="Index" class="@(Activo("MDEgresos", null) ? "activo" : "")">Egresos</a></li> }
                        @if (Puede("submenu2_7")) { <li><a asp-controller="MDIngresos" asp-action="Index" class="@(Activo("MDIngresos", null) ? "activo" : "")">Ingresos</a></li> }
                        @if (Puede("submenu2_8")) { <li><a asp-controller="MDInicials" asp-action="Index" class="@(Activo("MDInicials", null) ? "activo" : "")">Saldo inicial</a></li> }
                    </ul>
                </li>
            }

            @if (Puede("menu1"))
            {
                <li class="app-nav-titulo">Administración</li>
                @if (Puede("submenu1_1")) { <li><a asp-controller="Configuracion" asp-action="Index" class="@(Activo("Configuracion", null) || Activo("MDGenerales", null) ? "activo" : "")"><i data-feather="settings"></i> Configuración</a></li> }
                @if (Puede("submenu1_2")) { <li><a asp-controller="MDUsuarios" asp-action="Index" class="@(Activo("MDUsuarios", null) ? "activo" : "")"><i data-feather="users"></i> Usuarios</a></li> }

                    var segActivo = GrupoActivo("MDRols", "MDRol_Usuario", "MDRol_Permisos", "MDMenuprins", "MDSubmenus");

                <li>
                    <span class="grupo" data-toggle="collapse" data-target="#nav-seguridad" aria-expanded="@(segActivo ? "true" : "false")" role="button"><i data-feather="shield"></i> Roles y permisos <i data-feather="chevron-right" class="flecha"></i></span>
                    <ul class="sub collapse @(segActivo ? "show" : "")" id="nav-seguridad">
                        @if (Puede("submenu1_3")) { <li><a asp-controller="MDRols" asp-action="Index" class="@(Activo("MDRols", null) ? "activo" : "")">Roles</a></li> }
                        @if (Puede("submenu1_6")) { <li><a asp-controller="MDRol_Usuario" asp-action="Index" class="@(Activo("MDRol_Usuario", null) ? "activo" : "")">Rol de cada usuario</a></li> }
                        @if (Puede("submenu1_7")) { <li><a asp-controller="MDRol_Permisos" asp-action="Index" class="@(Activo("MDRol_Permisos", null) ? "activo" : "")">Permisos por rol</a></li> }
                        @if (Puede("submenu1_4")) { <li><a asp-controller="MDMenuprins" asp-action="Index" class="@(Activo("MDMenuprins", null) ? "activo" : "")">Módulos del menú</a></li> }
                        @if (Puede("submenu1_5")) { <li><a asp-controller="MDSubmenus" asp-action="Index" class="@(Activo("MDSubmenus", null) ? "activo" : "")">Submenús</a></li> }
                    </ul>
                </li>
            }
        </ul>
    </aside>
    <div class="app-velo" id="velo"></div>

    <div class="app-cuerpo">
        <header class="app-barra">
            <button type="button" class="app-hamburguesa" id="abrirMenu" aria-label="Abrir menú" aria-controls="menu"><i data-feather="menu"></i></button>
            <h1 class="app-barra-titulo">@titulo</h1>
            @if (ayuda != null)
            {
                <button type="button" class="ayuda-btn" id="ayudaBtn" aria-expanded="false" aria-controls="ayudaPanel" title="¿Qué hace esta pantalla?">?</button>
            }
            <span class="espacio"></span>
            <div class="dropdown">
                <button class="app-usuario" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <span class="app-avatar">@iniciales</span>
                    <span class="nombre">@nombre</span>
                    <i data-feather="chevron-down" style="width:16px;height:16px"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right">
                    <span class="dropdown-item-text text-muted small">Usuario: @SessionHelper.GetNameIdentifier(User)</span>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item" asp-controller="Home" asp-action="Logout">Cerrar sesión</a>
                </div>
            </div>
        </header>

        @if (ayuda != null)
        {
            <section class="ayuda-panel" id="ayudaPanel" role="dialog" aria-labelledby="ayudaTitulo">
                <button type="button" class="ayuda-cerrar" id="ayudaCerrar" aria-label="Cerrar ayuda">&times;</button>
                <h3 id="ayudaTitulo">@ayuda.Titulo</h3>
                <h4>¿Qué hace?</h4>
                <p>@ayuda.Que</p>
                @if (ayuda.Requisitos.Length > 0)
                {
                    <div class="req">
                        <h4>Requisitos</h4>
                        <ul>@foreach (var r in ayuda.Requisitos) { <li>@r</li> }</ul>
                    </div>
                }
                @if (ayuda.Recomendaciones.Length > 0)
                {
                    <div class="rec">
                        <h4>Recomendaciones</h4>
                        <ul>@foreach (var r in ayuda.Recomendaciones) { <li>@r</li> }</ul>
                    </div>
                }
            </section>
        }

        <main class="app-contenido">
            @if (TempData["success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">@TempData["success"]<button type="button" class="close" data-dismiss="alert" aria-label="Cerrar"><span aria-hidden="true">&times;</span></button></div>
            }
            @if (TempData["error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">@TempData["error"]<button type="button" class="close" data-dismiss="alert" aria-label="Cerrar"><span aria-hidden="true">&times;</span></button></div>
            }
            @RenderBody()
        </main>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/feather-icons@4.29.2/dist/feather.min.js"></script>
<script>
(function () {
    if (window.feather) feather.replace();

    // Menu lateral en celulares
    var app = document.getElementById('app');
    function menu(abrir) { app.classList.toggle('menu-abierto', abrir); }
    document.getElementById('abrirMenu').addEventListener('click', function () { menu(true); });
    document.getElementById('velo').addEventListener('click', function () { menu(false); });

    // Ayuda de la pantalla
    var btn = document.getElementById('ayudaBtn'), panel = document.getElementById('ayudaPanel');
    if (btn && panel) {
        function ayuda(abrir) {
            panel.classList.toggle('abierto', abrir);
            btn.setAttribute('aria-expanded', abrir ? 'true' : 'false');
            if (abrir) panel.querySelector('.ayuda-cerrar').focus(); else btn.focus();
        }
        btn.addEventListener('click', function (e) { e.stopPropagation(); ayuda(!panel.classList.contains('abierto')); });
        document.getElementById('ayudaCerrar').addEventListener('click', function () { ayuda(false); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && panel.classList.contains('abierto')) ayuda(false); });
        document.addEventListener('click', function (e) { if (panel.classList.contains('abierto') && !panel.contains(e.target)) ayuda(false); });
    }
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
