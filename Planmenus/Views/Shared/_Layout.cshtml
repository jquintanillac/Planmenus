@using Planmenus.Helpers
@inject Planmenus.Services.TicketService Tickets
@inject Planmenus.Data.EmpresaActual EmpresaHoy
@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    var ayuda = Ayuda.Buscar(controlador, accion);
    var empresa = await Tickets.ObtenerEmpresaAsync();
    var nombre = SessionHelper.GetName(User);
    var iniciales = string.Concat((nombre ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
    var titulo = ayuda?.Titulo ?? (ViewData["Title"] as string ?? "");
    bool Puede(string claim) => SessionHelper.GetValue(User, claim) == "S";
    bool Activo(string c, string a) => string.Equals(c, controlador, StringComparison.OrdinalIgnoreCase)
                                       && (a == null || string.Equals(a, accion, StringComparison.OrdinalIgnoreCase));
    bool GrupoActivo(params string[] controladores) => controladores.Any(c => string.Equals(c, controlador, StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@(string.IsNullOrEmpty(titulo) ? "" : titulo + " · ")@empresa.gene_empre</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tema.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" />
</head>
<body>
<div class="app" id="app">
    <aside class="app-menu" id="menu" aria-label="Menú principal">
        <a class="app-marca" asp-controller="Home" asp-action="Inicio">
            <span class="app-marca-icono" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18h18"/><path d="M4 18a8 8 0 0 1 16 0"/><path d="M12 7V5"/><path d="M10 5h4"/></svg>
            </span>
            <span class="app-marca-texto">
                <strong>@empresa.gene_empre</strong>
                <small>Menú del día</small>
            </span>
        </a>

        @{
            // Menu lateral: cada seccion es un acordeon; se abre sola la seccion de la pantalla actual
            var reportes = new[]
            {
                new Op("submenu3_4", "MDCajas", "RptListpagos", null, "Resumen por tipo de pago"),
                new Op("submenu3_5", "MDCajas", "Rpttipodepago", null, "Ventas por tipo de pago"),
                new Op("submenu3_6", "MDCajas", "Rptporplato", null, "Resumen por plato"),
                new Op("submenu3_7", "MDCajas", "Rptcantplato", null, "Ventas por plato"),
            };
            var catalogos = new[]
            {
                new Op("submenu2_5", "MDMesas", null, null, "Mesas"),
                new Op("submenu2_2", "MDTipo_pago", null, null, "Tipos de pago"),
                new Op("submenu2_3", "MDDeliveries", null, null, "Repartidores"),
                new Op("submenu2_6", "MDEgresos", null, null, "Egresos"),
                new Op("submenu2_7", "MDIngresos", null, null, "Ingresos"),
                new Op("submenu2_8", "MDInicials", null, null, "Saldo inicial"),
            };
            var seguridad = new[]
            {
                new Op("submenu1_3", "MDRols", null, null, "Roles"),
                new Op("submenu1_6", "MDRol_Usuario", null, null, "Rol de cada usuario"),
                new Op("submenu1_7", "MDRol_Permisos", null, null, "Permisos por rol"),
                new Op("submenu1_4", "MDMenuprins", null, null, "Módulos del menú"),
                new Op("submenu1_5", "MDSubmenus", null, null, "Submenús"),
            };
            var secciones = new[]
            {
                new Seccion("atencion", "Atención", "coffee", new[]
                {
                    new Op("submenu3_1", "MDCajas", "Create", "shopping-bag", "Nueva venta"),
                    new Op("submenu3_8", "Salon", null, "grid", "Salón y mesas"),
                    new Op("submenu3_9", "Cocina", null, "bell", "Cocina"),
                    new Op("submenu3_11", "Reservas", null, "calendar", "Reservas"),
                    new Op("submenu3_12", "Mozos", null, "user-check", "Planificar mozos"),
                }),
                new Seccion("caja", "Caja", "dollar-sign", new[]
                {
                    new Op("submenu3_10", "Turnos", null, "lock", "Apertura y cierre"),
                    new Op("submenu3_3", "MDCajas", "Cajadiaria", "list", "Lista de tickets", Extra: Activo("MDCajas", "Edit")),
                    new Op("submenu3_13", "Comprobantes", null, "file", "Comprobantes electrónicos"),
                    new Op("submenu3_2", "MDCajas", "Index", "file-text", "Cuadre de caja"),
                    new Op(null, null, null, "bar-chart-2", "Reportes", Hijos: reportes),
                }),
                new Seccion("carta", "Carta y planificación", "book-open", new[]
                {
                    new Op("submenu2_1", "MDMenus", null, "book-open", "Menú del día", Excluir: "Calendar"),
                    new Op("submenu2_4", "MDMenus", "Calendar", "calendar", "Calendario de menús"),
                    new Op("submenu2_9", "Carta", null, "smartphone", "Carta digital (QR)"),
                    new Op("submenu2_10", "Plano", null, "layout", "Plano del salón"),
                    new Op(null, null, null, "layers", "Catálogos y movimientos", Hijos: catalogos),
                }),
                new Seccion("admin", "Administración", "settings", new[]
                {
                    new Op("submenu1_1", "Configuracion", null, "settings", "Configuración", Extra: Activo("MDGenerales", null)),
                    new Op("submenu1_1", "Ticketera", null, "printer", "Ticketera"),
                    new Op("submenu1_1", "Facturacion", null, "award", "Facturación electrónica"),
                    new Op("submenu1_2", "MDUsuarios", null, "users", "Usuarios"),
                    new Op("submenu1_1", "Suscripcion", null, "credit-card", "Mi suscripción"),
                    new Op(null, null, null, "shield", "Roles y permisos", Hijos: seguridad),
                }),
            };
            bool Visible(Op o) => o.Hijos != null ? o.Hijos.Any(Visible) : Puede(o.Claim);
            bool EsActivo(Op o) => o.Hijos != null ? o.Hijos.Any(EsActivo)
                : o.Extra || (Activo(o.Ctrl, o.Act) && !string.Equals(accion, o.Excluir, StringComparison.OrdinalIgnoreCase));
        }
        <ul class="app-nav" id="nav">
            <li><a asp-controller="Home" asp-action="Inicio" class="@(Activo("Home", "Inicio") ? "activo" : "")"><i data-feather="home"></i> Inicio</a></li>

            @foreach (var s in secciones.Where(s => s.Opciones.Any(Visible)))
            {
                var abierta = s.Opciones.Any(EsActivo);
                <li class="app-nav-seccion">
                    <button type="button" class="app-nav-titulo" data-toggle="collapse" data-target="#sec-@s.Id" aria-expanded="@(abierta ? "true" : "false")" aria-controls="sec-@s.Id" data-seccion="@s.Id" data-activa="@(abierta ? "1" : "0")">
                        <span>@s.Titulo</span><i data-feather="chevron-down" class="flecha"></i>
                    </button>
                    <ul class="collapse @(abierta ? "show" : "")" id="sec-@s.Id">
                        @foreach (var o in s.Opciones.Where(Visible))
                        {
                            if (o.Hijos == null)
                            {
                                <li><a asp-controller="@o.Ctrl" asp-action="@(o.Act ?? "Index")" class="@(EsActivo(o) ? "activo" : "")"><i data-feather="@o.Icono"></i> @o.Texto</a></li>
                            }
                            else
                            {
                                var grupoActivo = EsActivo(o);
                                var idGrupo = "grp-" + s.Id;
                                <li>
                                    <span class="grupo" data-toggle="collapse" data-target="#@idGrupo" aria-expanded="@(grupoActivo ? "true" : "false")" role="button"><i data-feather="@o.Icono"></i> @o.Texto <i data-feather="chevron-right" class="flecha"></i></span>
                                    <ul class="sub collapse @(grupoActivo ? "show" : "")" id="@idGrupo">
                                        @foreach (var h in o.Hijos.Where(Visible))
                                        {
                                            <li><a asp-controller="@h.Ctrl" asp-action="@(h.Act ?? "Index")" class="@(EsActivo(h) ? "activo" : "")">@h.Texto</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                        }
                    </ul>
                </li>
            }

            @if (Puede(SessionHelper.ClaimSuperadmin))
            {
                <li><a asp-controller="Plataforma" asp-action="Index" class="@(Activo("Plataforma", null) ? "activo" : "")"><i data-feather="globe"></i> Plataforma</a></li>
            }
        </ul>
    </aside>
    <div class="app-velo" id="velo"></div>

    <div class="app-cuerpo">
        <header class="app-barra">
            <button type="button" class="app-hamburguesa" id="abrirMenu" aria-label="Abrir menú" aria-controls="menu"><i data-feather="menu"></i></button>
            <h1 class="app-barra-titulo">@titulo</h1>
            @if (ayuda != null)
            {
                <button type="button" class="ayuda-btn" id="ayudaBtn" aria-expanded="false" aria-controls="ayudaPanel" title="¿Qué hace esta pantalla?">?</button>
            }
            <span class="espacio"></span>
            <div class="dropdown">
                <button class="app-usuario" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <span class="app-avatar">@iniciales</span>
                    <span class="nombre">@nombre</span>
                    <i data-feather="chevron-down" style="width:16px;height:16px"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right">
                    <span class="dropdown-item-text text-muted small">Usuario: @SessionHelper.GetNameIdentifier(User)</span>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item" asp-controller="Home" asp-action="Logout">Cerrar sesión</a>
                </div>
            </div>
        </header>

        @if (ayuda != null)
        {
            <section class="ayuda-panel" id="ayudaPanel" role="dialog" aria-labelledby="ayudaTitulo">
                <button type="button" class="ayuda-cerrar" id="ayudaCerrar" aria-label="Cerrar ayuda">&times;</button>
                <h3 id="ayudaTitulo">@ayuda.Titulo</h3>
                <h4>¿Qué hace?</h4>
                <p>@ayuda.Que</p>
                @if (ayuda.Requisitos.Length > 0)
                {
                    <div class="req">
                        <h4>Requisitos</h4>
                        <ul>@foreach (var r in ayuda.Requisitos) { <li>@r</li> }</ul>
                    </div>
                }
                @if (ayuda.Recomendaciones.Length > 0)
                {
                    <div class="rec">
                        <h4>Recomendaciones</h4>
                        <ul>@foreach (var r in ayuda.Recomendaciones) { <li>@r</li> }</ul>
                    </div>
                }
            </section>
        }

        <main class="app-contenido">
            @{ var diasVence = Planmenus.Services.PlanService.DiasParaVencer(EmpresaHoy.Vence); }
            @if (diasVence <= 5 && !Activo("Suscripcion", null))
            {
                <div class="alert alert-warning d-flex justify-content-between align-items-center flex-wrap" role="status" style="gap:10px">
                    <span>@(diasVence < 0 ? $"Su suscripción venció hace {-diasVence} día(s)." : diasVence == 0 ? "Su suscripción vence hoy." : $"Su suscripción vence en {diasVence} día(s).") Renuévela para no perder el acceso.</span>
                    <a asp-controller="Suscripcion" asp-action="Index" class="btn btn-sm btn-primary">Ver mi suscripción</a>
                </div>
            }
            @if (TempData["success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">@TempData["success"]<button type="button" class="close" data-dismiss="alert" aria-label="Cerrar"><span aria-hidden="true">&times;</span></button></div>
            }
            @if (TempData["error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">@TempData["error"]<button type="button" class="close" data-dismiss="alert" aria-label="Cerrar"><span aria-hidden="true">&times;</span></button></div>
            }
            @RenderBody()
        </main>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/feather-icons@4.29.2/dist/feather.min.js"></script>
<script>
(function () {
    if (window.feather) feather.replace();

    // Menu lateral en celulares
    var app = document.getElementById('app');
    function menu(abrir) { app.classList.toggle('menu-abierto', abrir); }
    document.getElementById('abrirMenu').addEventListener('click', function () { menu(true); });
    document.getElementById('velo').addEventListener('click', function () { menu(false); });

    // Secciones del menu: se recuerda cuales dejo abiertas el usuario (la de la pantalla actual siempre se abre)
    try {
        var guardadas = JSON.parse(localStorage.getItem('menu-secciones') || '{}');
        document.querySelectorAll('.app-nav-titulo[data-seccion]').forEach(function (b) {
            var id = b.dataset.seccion;
            if (b.dataset.activa !== '1' && guardadas[id] === true) { $('#sec-' + id).addClass('show'); b.setAttribute('aria-expanded', 'true'); }
        });
        $('.app-nav-seccion > ul').on('shown.bs.collapse hidden.bs.collapse', function (e) {
            if (e.target !== this) return;
            guardadas[this.id.replace('sec-', '')] = e.type === 'shown';
            localStorage.setItem('menu-secciones', JSON.stringify(guardadas));
        });
    } catch (e) { }

    // Ayuda de la pantalla
    var btn = document.getElementById('ayudaBtn'), panel = document.getElementById('ayudaPanel');
    if (btn && panel) {
        function ayuda(abrir) {
            panel.classList.toggle('abierto', abrir);
            btn.setAttribute('aria-expanded', abrir ? 'true' : 'false');
            if (abrir) panel.querySelector('.ayuda-cerrar').focus(); else btn.focus();
        }
        btn.addEventListener('click', function (e) { e.stopPropagation(); ayuda(!panel.classList.contains('abierto')); });
        document.getElementById('ayudaCerrar').addEventListener('click', function () { ayuda(false); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && panel.classList.contains('abierto')) ayuda(false); });
        document.addEventListener('click', function (e) { if (panel.classList.contains('abierto') && !panel.contains(e.target)) ayuda(false); });
    }
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@functions {
    /// <summary>Opcion del menu lateral; con Hijos es un grupo desplegable</summary>
    record Op(string Claim, string Ctrl, string Act, string Icono, string Texto, bool Extra = false, string Excluir = null, Op[] Hijos = null);
    record Seccion(string Id, string Titulo, string Icono, Op[] Opciones);
}
