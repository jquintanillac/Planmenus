@using Planmenus.Data.Entities
@model MDGenerales
@{
    ViewData["Title"] = "Configuración";
    var tipos = (List<MDTipo_pago>)ViewBag.tipos_pago;
    var formato = (MDTicketera)ViewBag.formato;
    var correo = (Planmenus.Services.CorreoOptions)ViewBag.correo;
}
<style>
    .conf-tabs { display: flex; gap: 6px; flex-wrap: wrap; border-bottom: 1px solid var(--borde); margin-bottom: 20px; }
    .conf-tabs a { padding: 10px 16px; border-radius: 10px 10px 0 0; color: var(--gris); font-weight: 600; text-decoration: none; border-bottom: 3px solid transparent; display: inline-flex; gap: 8px; align-items: center; }
    .conf-tabs a svg { width: 16px; height: 16px; }
    .conf-tabs a.active { color: var(--aji-osc); border-bottom-color: var(--aji); background: var(--papel); }
    .conf-tabs a:hover { color: var(--tinta); }
    .opcion-ancho { display: flex; gap: 12px; }
    .opcion-ancho label { flex: 1; border: 2px solid var(--borde); border-radius: 14px; padding: 14px; cursor: pointer; text-align: center; font-weight: 600; transition: border-color .15s, background .15s; }
    .opcion-ancho input { position: absolute; opacity: 0; }
    .opcion-ancho input:checked + span { color: var(--aji-osc); }
    .opcion-ancho label:has(input:checked) { border-color: var(--aji); background: var(--aji-suave); }
    .opcion-ancho .papel { display: block; margin: 0 auto 8px; height: 46px; background: repeating-linear-gradient(180deg, #fff 0 6px, var(--crema) 6px 8px); border: 1px solid var(--borde); border-radius: 4px; }
    .estado-ticketera { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-radius: 12px; }
</style>

<form asp-action="Index" method="post">
    <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <nav class="conf-tabs nav" role="tablist">
        <a class="active" data-toggle="tab" href="#t-negocio" role="tab"><i data-feather="briefcase"></i> Negocio</a>
        <a data-toggle="tab" href="#t-ticket" role="tab"><i data-feather="printer"></i> Ticket y ticketera</a>
        <a data-toggle="tab" href="#t-pagos" role="tab"><i data-feather="credit-card"></i> Pagos</a>
        <a data-toggle="tab" href="#t-correo" role="tab"><i data-feather="mail"></i> Correo y reservas</a>
        <a data-toggle="tab" href="#t-carta" role="tab"><i data-feather="smartphone"></i> Carta digital</a>
    </nav>

    <div class="tab-content">
        <section class="tab-pane fade show active" id="t-negocio" role="tabpanel">
            <div class="card"><div class="card-body">
                <p class="text-muted">Estos datos salen en el ticket, el cuadre de caja y la carta digital.</p>
                <div class="form-row">
                    <div class="form-group col-md-8">
                        <label asp-for="gene_empre">Nombre del negocio *</label>
                        <input asp-for="gene_empre" class="form-control" placeholder="Ej.: Cevichería Doña Pepa" required maxlength="100" />
                        <span asp-validation-for="gene_empre" class="text-danger small"></span>
                    </div>
                    <div class="form-group col-md-4">
                        <label asp-for="gene_ruc">RUC</label>
                        <input asp-for="gene_ruc" class="form-control" inputmode="numeric" maxlength="11" placeholder="11 dígitos" />
                        <span asp-validation-for="gene_ruc" class="text-danger small"></span>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-8">
                        <label asp-for="gene_direc">Dirección</label>
                        <input asp-for="gene_direc" class="form-control" placeholder="Av. Larco 123, Miraflores" />
                    </div>
                    <div class="form-group col-md-4">
                        <label asp-for="gene_telef">Teléfono / WhatsApp</label>
                        <input asp-for="gene_telef" class="form-control" inputmode="tel" placeholder="987 654 321" />
                    </div>
                </div>
                <div class="form-group mb-0">
                    <label asp-for="gene_url">Página web o redes</label>
                    <input asp-for="gene_url" class="form-control" placeholder="instagram.com/minegocio" />
                </div>
            </div></div>
        </section>

        <section class="tab-pane fade" id="t-ticket" role="tabpanel">
            <div class="card"><div class="card-body d-flex flex-wrap align-items-center" style="gap:16px">
                <div class="kpi-icono mb-0" style="--color-kpi:var(--aji)"><i data-feather="printer"></i></div>
                <div class="flex-fill">
                    <h4 class="mb-1">Ticketera</h4>
                    <p class="text-muted mb-0">
                        @(formato.tk_modo switch { ModoImpresion.Red => $"Ticketera de red en {formato.tk_ip}:{formato.tk_puerto}", ModoImpresion.Agente => $"Agente local · impresora {formato.tk_impresora ?? "sin elegir"}", _ => "Impresión desde el navegador" })
                        · papel @formato.tk_ancho_mm mm · @(formato.tk_logo_raster != null ? "con logo" : "sin logo")
                    </p>
                </div>
                <a class="btn btn-primary" asp-controller="Ticketera" asp-action="Index">Configurar ticketera y ticket</a>
            </div></div>
        </section>

        <section class="tab-pane fade" id="t-pagos" role="tabpanel">
            <div class="card"><div class="card-body">
                <h4 class="mb-1">¿Qué pagos son efectivo?</h4>
                <p class="text-muted">Marque los que entran a la gaveta. El cierre de caja suma solo estos al calcular el efectivo esperado.</p>
                @foreach (var tp in tipos)
                {
                    <div class="custom-control custom-switch mb-2">
                        <input type="checkbox" class="custom-control-input" id="ef-@tp.id_tipago" name="efectivo" value="@tp.id_tipago" @(tp.tipago_efectivo ? "checked" : "") />
                        <label class="custom-control-label" for="ef-@tp.id_tipago">@tp.tipago_desc @if (!tp.tipago_act) { <span class="badge badge-anul ml-1">inactivo</span> }</label>
                    </div>
                }
                <a class="small" asp-controller="MDTipo_pago" asp-action="Index">Agregar o editar tipos de pago →</a>
            </div></div>
        </section>

        <section class="tab-pane fade" id="t-correo" role="tabpanel">
            <div class="row">
                <div class="col-lg-6">
                    <div class="card"><div class="card-body">
                        <h4 class="mb-1">Servidor de correo</h4>
                        <p class="text-muted small">Las credenciales se configuran en <code>appsettings.json</code> (sección <code>Correo</code>) o como variables de entorno del hosting (<code>Correo__Host</code>, <code>Correo__Clave</code>…). Por seguridad no se muestran ni se editan aquí.</p>
                        <div class="estado-ticketera mb-3" style="background:@(correo.Configurado ? "var(--hierba-suave)" : "var(--mostaza-suave)")">
                            <i data-feather="@(correo.Configurado ? "check-circle" : "alert-triangle")" style="color:@(correo.Configurado ? "var(--hierba)" : "#8a5a0b")"></i>
                            <span>@(correo.Configurado ? $"Configurado: {correo.Host}:{correo.Puerto} · envía como {correo.Remitente}" : "Sin configurar: las reservas se guardan pero no se envían avisos")</span>
                        </div>
                        <label for="destinoPrueba">Enviar correo de prueba a</label>
                        <div class="d-flex" style="gap:8px">
                            <input id="destinoPrueba" name="destino" form="formPruebaCorreo" type="email" class="form-control" placeholder="su-correo@ejemplo.com" />
                            <button type="submit" form="formPruebaCorreo" class="btn btn-light text-nowrap" @(correo.Configurado ? "" : "disabled")>Probar</button>
                        </div>
                        <details class="small text-muted mt-3">
                            <summary>Ejemplo para Gmail</summary>
                            <pre class="mt-2 mb-0" style="white-space:pre-wrap">"Correo": {
  "Host": "smtp.gmail.com", "Puerto": 587, "UsarSsl": false,
  "Usuario": "minegocio@gmail.com", "Clave": "contraseña de aplicación",
  "Remitente": "minegocio@gmail.com", "NombreRemitente": "Mi Negocio"
}</pre>
                            <div class="mt-1">En Gmail la clave es una “contraseña de aplicación” (Cuenta de Google → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones).</div>
                        </details>
                    </div></div>
                </div>
                <div class="col-lg-6">
                    <div class="card"><div class="card-body">
                        <h4 class="mb-3">Avisos de reservas</h4>
                        <div class="form-group">
                            <label asp-for="gene_correo_avisos">Avisar también a</label>
                            <input asp-for="gene_correo_avisos" class="form-control" maxlength="500" placeholder="encargado@ejemplo.com, cocina@ejemplo.com" />
                            <small class="form-text text-muted">Reciben una copia de cada confirmación, recordatorio y cancelación. Separe con comas.</small>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-6">
                                <label asp-for="gene_recordatorio_horas">Recordatorio</label>
                                <select asp-for="gene_recordatorio_horas" class="form-control">
                                    @foreach (var h in new[] { 1, 2, 3, 4, 6, 12, 24, 48 }) { <option value="@h">@h hora@(h > 1 ? "s" : "") antes</option> }
                                </select>
                            </div>
                            <div class="form-group col-6">
                                <label asp-for="gene_reserva_minutos">Duración por defecto</label>
                                <select asp-for="gene_reserva_minutos" class="form-control">
                                    @foreach (var m in new[] { 60, 90, 120, 150, 180, 240 }) { <option value="@m">@(m % 60 == 0 ? m / 60 + " h" : $"{m / 60} h {m % 60} min")</option> }
                                </select>
                            </div>
                        </div>
                        <p class="small text-muted mb-0">Los recordatorios se revisan cada 5 minutos. En hosting compartido active “siempre encendido” (Always On) o un monitor que visite el sitio cada 5 minutos para que no se detengan.</p>
                    </div></div>
                </div>
            </div>
        </section>

        <section class="tab-pane fade" id="t-carta" role="tabpanel">
            <div class="card"><div class="card-body d-flex flex-wrap align-items-center" style="gap:16px">
                <div class="flex-fill">
                    <h4 class="mb-1">Carta digital</h4>
                    <p class="text-muted mb-2">Página pública con los platos de hoy, el nombre del negocio, la dirección y el teléfono de esta configuración.</p>
                    <code>@ViewBag.url_carta</code>
                </div>
                <a class="btn btn-light" href="@ViewBag.url_carta" target="_blank">Ver carta</a>
                <a class="btn btn-mostaza" asp-controller="Carta" asp-action="Qr">Imprimir QR</a>
            </div></div>
        </section>
    </div>

    <div class="d-flex align-items-center flex-wrap" style="gap:10px">
        <button type="submit" class="btn btn-primary btn-lg"><i data-feather="save" style="width:18px;height:18px"></i> Guardar configuración</button>
        <span class="text-muted small">Los cambios se guardan para todas las pestañas.</span>
    </div>
</form>

<form asp-action="ProbarCorreo" method="post" id="formPruebaCorreo"></form>
}

@section Scripts {
<script>
    // Recuerda la pestaña abierta y muestra la que tiene errores de validacion
    (function () {
        var tabs = $('.conf-tabs a');
        tabs.on('shown.bs.tab', function (e) { try { sessionStorage.setItem('conf-tab', e.target.getAttribute('href')); } catch (x) { } });
        var conError = $('.tab-pane .text-danger:not(:empty)').first().closest('.tab-pane').attr('id');
        var guardada = null; try { guardada = sessionStorage.getItem('conf-tab'); } catch (x) { }
        var destino = conError ? '#' + conError : guardada;
        if (destino) tabs.filter('[href="' + destino + '"]').tab('show');
    })();
</script>
}
